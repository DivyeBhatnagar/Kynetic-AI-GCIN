# Environment
APP_ENV=production
POSTGRES_DB=kynetic_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Database URLs
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/kynetic_dev
DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/kynetic_dev

# Connection Pooling
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Caching
REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true
REDIS_CONNECT_TIMEOUT=2.0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_MAX_CONNECTIONS=20

# Cache TTLs (seconds)
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_CATALOG_TTL_SECONDS=600
CACHE_OFFERS_TTL_SECONDS=180
CACHE_PRICING_TTL_SECONDS=120
CACHE_ESTIMATES_TTL_SECONDS=300

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Security
AUTH_SECRET_KEY=kynetic_dev_secret_change_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENABLE_BILLABLE_EXECUTION=false
DEFAULT_PROVIDER_MODE=simulated
LOG_LEVEL=INFO
