# Environment: development, staging, production, test
APP_ENV=development
APP_NAME=Kynetic AI Engine
API_V1_PREFIX=/v1
DEBUG=true
INSTANCE_ID=inst-dev-1

# Database: PostgreSQL (asyncpg for runtime, psycopg2 for sync migrations)
# In development/test with no local Postgres running, sqlite+aiosqlite is also supported
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kynetic_dev
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/kynetic_dev

# Database Connection Pooling (for multi-instance load balancing)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Redis Caching (Optional: when disabled, in-memory fallback cache is active)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false
REDIS_CONNECT_TIMEOUT=2.0
REDIS_SOCKET_TIMEOUT=2.0
REDIS_MAX_CONNECTIONS=20

# Cache TTL Configuration (in seconds)
CACHE_DEFAULT_TTL_SECONDS=300
CACHE_CATALOG_TTL_SECONDS=600
CACHE_OFFERS_TTL_SECONDS=180
CACHE_PRICING_TTL_SECONDS=120
CACHE_ESTIMATES_TTL_SECONDS=300

# Rate Limiting & Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120
RATE_LIMIT_BURST=30

# Security & Multi-Tenancy (NEVER COMMIT PRODUCTION SECRETS)
AUTH_SECRET_KEY=kynetic_dev_secret_change_in_production_32chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Execution Safeguards (default to false for safety)
ENABLE_BILLABLE_EXECUTION=false
DEFAULT_PROVIDER_MODE=simulated

# Logging
LOG_LEVEL=INFO
